  "version": "1.0.10",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env src/main.ts",
    "dev:db": "node --env-file-if-exists=../../.env scripts/dev-db.ts",
    "migrate": "node --env-file-if-exists=../../.env src/database/migrate-cli.ts",
    "rotate-key": "node --env-file-if-exists=../../.env src/ops/rotate-key-cli.ts",
    "db:backup": "node --env-file-if-exists=../../.env src/ops/backup-cli.ts backup",
    "db:restore": "node --env-file-if-exists=../../.env src/ops/backup-cli.ts restore",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run"
  },
  "dependencies": {
