{
  "name": "@nigafiy/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "LAN Detective desktop app: the dashboard plus a bundled, managed collector",
  "author": "LAN Detective",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke",
    "test": "node --test \"test/*.test.cjs\"",
    "icon": "node scripts/make-icon.mjs",
    "pack": "node scripts/bundle-backend.mjs && node scripts/signing.cjs ../../collectors/lan-collector/bin/lan-collector.exe ../../engine/bin/nigafiy-engine.exe && electron-builder --win dir",
    "dist": "node scripts/bundle-backend.mjs && node scripts/signing.cjs ../../collectors/lan-collector/bin/lan-collector.exe ../../engine/bin/nigafiy-engine.exe && electron-builder --win nsis",
    "dist:msi": "node scripts/bundle-backend.mjs && node scripts/signing.cjs ../../collectors/lan-collector/bin/lan-collector.exe ../../engine/bin/nigafiy-engine.exe && electron-builder --win msi",
    "bundle": "node scripts/bundle-backend.mjs",
    "release": "node ../../scripts/release/release.mjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.landetective.desktop",
    "productName": "LAN Detective",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../collectors/lan-collector/bin/lan-collector.exe",
        "to": "collector/lan-collector.exe"
      },
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "../../engine/bin/nigafiy-engine.exe",
        "to": "engine/nigafiy-engine.exe"
      },
      {
        "from": "../../packages/brand/ico",
        "to": "icons",
        "filter": [
          "*.ico"
        ]
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "signtoolOptions": {
        "sign": "./scripts/signing.cjs",
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "msi": {
      "oneClick": true,
      "perMachine": true,
      "upgradeCode": "6DA7D862-27E7-4AC8-809D-89B4128FB3AE",
      "createDesktopShortcut": true,
      "runAfterFinish": false,
      "warningsAsErrors": false
    }
  }
}
