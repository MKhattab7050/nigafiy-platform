# Line endings: the repository stores text with LF. Source, docs, SVG and shell files are also checked
# out with LF on every OS, so generators (packages/brand `pnpm build`, scripts/make-readme-art.mjs) and
# formatters write exactly what git has. Windows-only scripts are checked out with CRLF.

* text=auto

# Source and configuration
*.ts       text eol=lf
*.tsx      text eol=lf
*.js       text eol=lf
*.mjs      text eol=lf
*.cjs      text eol=lf
*.go       text eol=lf
*.mod      text eol=lf
*.sum      text eol=lf
*.sql      text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.xml      text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.svg      text eol=lf
*.sh       text eol=lf
*.service  text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.dockerignore text eol=lf
.env.example text eol=lf

# Windows scripts
*.cmd      text eol=crlf
*.bat      text eol=crlf
*.ps1      text eol=crlf

# Binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.msi      binary
*.msix     binary
*.exe      binary
*.pfx      binary
*.cer      binary
*.zip      binary
*.woff     binary
*.woff2    binary
