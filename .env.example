# ---------- Nigafiy API ----------
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Owner connection: runs migrations and platform-level (cross-tenant) jobs.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lan_detective
# Restricted role used for ALL tenant data access. Row Level Security applies to it.
# The migrate command creates/updates the `lan_app` role with this password.
APP_DATABASE_URL=postgres://lan_app:change-me-app-password@localhost:5433/lan_detective

# 32 random bytes, hex encoded. Encrypts stored secrets (webhook signing keys, ...).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# To change it later, use the rotation tool (docs/operations/backup-restore-and-key-rotation.md).
APP_ENCRYPTION_KEY=

# Optional: share rate-limit counters between several API instances (redis:// or rediss://).
# Leave empty for one instance: counters stay in memory. If Redis becomes unreachable, each
# instance falls back to its own memory counters until it is back.
REDIS_URL=

# Optional: folder holding pg_dump / pg_restore for the backup tool (embedded PostgreSQL does not
# include them). See docs/operations/backup-restore-and-key-rotation.md.
# Variables were renamed LD_* -> NIGAFIY_* (Sensor: LAN_COLLECTOR_* -> NIGAFIY_SENSOR_*, Agent:
# LAN_ENDPOINT_* -> NIGAFIY_AGENT_*). The old names still work and log a one-time deprecation line;
# the new name wins when both are set. Full list: docs/architecture/naming.md.
NIGAFIY_PG_BIN_DIR=

# Browser origin of the web app (used for CSRF origin checks).
WEB_ORIGIN=http://localhost:3100
# Extra origins the web app is opened from (comma separated), e.g. a phone on the LAN.
WEB_EXTRA_ORIGINS=
SESSION_TTL_HOURS=168
ALLOW_REGISTRATION=true
# "loopback" when the API sits behind the local Next.js proxy; set to your proxy hops in production.
TRUST_PROXY=loopback

# Development / test only. Never enable in production.
ALLOW_LOOPBACK_SCOPES=false
ALLOW_PRIVATE_WEBHOOKS=false

# Notification email may use a mail relay on your own network (private address).
# Set to false when the server is hosted for other organizations.
SMTP_ALLOW_PRIVATE_HOSTS=true

# HTTPS for collectors and agents on your network (docs/features/lan-tls.md). Uncomment to enable.
# Without TLS_CERT_FILE / TLS_KEY_FILE, Nigafiy creates a local CA + server certificate (LAN_TLS=auto)
# and shows the CA fingerprint to pin in Hub -> Sensors.
#HTTPS_PORT=4443
#HTTPS_HOST=0.0.0.0
#LAN_TLS=auto
#TLS_CERT_FILE=
#TLS_KEY_FILE=

# ---------- Web ----------
API_INTERNAL_URL=http://localhost:4100
