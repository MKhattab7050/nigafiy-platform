# ---------- LAN Detective API ----------
NODE_ENV=development
PORT=4100
LOG_LEVEL=info

# Owner connection: runs migrations and platform-level (cross-tenant) jobs.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/lan_detective
# Restricted role used for ALL tenant data access. Row Level Security applies to it.
# The migrate command creates/updates the `lan_app` role with this password.
APP_DATABASE_URL=postgres://lan_app:change-me-app-password@localhost:5433/lan_detective

# 32 random bytes, hex encoded. Encrypts stored secrets (webhook signing keys, ...).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=

# Browser origin of the web app (used for CSRF origin checks).
WEB_ORIGIN=http://localhost:3100
SESSION_TTL_HOURS=168
ALLOW_REGISTRATION=true
# "loopback" when the API sits behind the local Next.js proxy; set to your proxy hops in production.
TRUST_PROXY=loopback

# Development / test only. Never enable in production.
ALLOW_LOOPBACK_SCOPES=false
ALLOW_PRIVATE_WEBHOOKS=false

# Notification email may use a mail relay on your own network (private address).
# Set to false when the server is hosted for other organizations.
SMTP_ALLOW_PRIVATE_HOSTS=true

# ---------- Web ----------
API_INTERNAL_URL=http://localhost:4100
