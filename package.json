{
  "name": "nigafiy",
  "private": true,
  "license": "UNLICENSED",
  "version": "1.0.4",
  "description": "Nigafiy — Network Intelligence & IT Infrastructure Operations Platform",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "local:autostart": "node scripts/local.mjs --install-autostart --only-autostart",
    "local:stop-autostart": "node scripts/local.mjs --uninstall-autostart --only-autostart",
    "start": "node scripts/local.mjs",
    "dev:db": "pnpm --filter @nigafiy/api dev:db",
    "dev:api": "pnpm --filter @nigafiy/api dev",
    "dev:web": "pnpm --filter @nigafiy/web dev",
    "migrate": "pnpm --filter @nigafiy/api migrate",
    "build": "pnpm --filter @nigafiy/brand build && pnpm --filter @nigafiy/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "check:brand": "node scripts/check-brand.mjs && node --test scripts/check-brand.test.mjs",
    "test:scripts": "node --test scripts/android/release-apk.test.mjs",
    "test": "pnpm --filter @nigafiy/api test",
    "test:web": "pnpm --filter @nigafiy/web test:e2e",
    "build:site": "pnpm --filter @nigafiy/site build",
    "test:site": "pnpm --filter @nigafiy/site build && pnpm --filter @nigafiy/site test",
    "test:collector": "cd collectors/lan-collector && go test ./...",
    "build:collector": "cd collectors/lan-collector && go build -o bin/ ./cmd/nigafiy-sensor",
    "test:agent": "cd agents/endpoint-agent && go test ./...",
    "build:agent": "cd agents/endpoint-agent && go build -o bin/ ./cmd/nigafiy-agent && go build -o bin/nigafiy-support.exe ./cmd/nigafiy-support",
    "test:engine": "cd engine && go test ./...",
    "build:engine": "cd engine && go build -trimpath -o bin/ ./cmd/nigafiy-engine",
    "build:launchers": "node scripts/build-launchers.mjs",
    "test:android": "node scripts/android/build.mjs --test-only",
    "build:android": "node scripts/android/build.mjs",
    "android:keystore": "node scripts/android/keystore.mjs",
    "build:agent-installer": "node scripts/installers/build-agent-installer.mjs",
    "release": "node scripts/release/release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
