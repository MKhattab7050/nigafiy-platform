{
  "name": "lan-detective",
  "private": true,
  "version": "0.1.0",
  "description": "LAN Detective — Network Intelligence & IT Infrastructure Operations Platform",
  "packageManager": "pnpm@10.34.8",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "local": "node scripts/local.mjs",
    "local:autostart": "node scripts/local.mjs --install-autostart --only-autostart",
    "local:stop-autostart": "node scripts/local.mjs --uninstall-autostart --only-autostart",
    "start": "node scripts/local.mjs",
    "dev:db": "pnpm --filter @lan-detective/api dev:db",
    "dev:api": "pnpm --filter @lan-detective/api dev",
    "dev:web": "pnpm --filter @lan-detective/web dev",
    "migrate": "pnpm --filter @lan-detective/api migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome lint .",
    "test": "pnpm --filter @lan-detective/api test",
    "test:web": "pnpm --filter @lan-detective/web test:e2e",
    "test:collector": "cd collectors/lan-collector && go test ./...",
    "build:collector": "cd collectors/lan-collector && go build -o bin/ ./cmd/lan-collector",
    "test:agent": "cd agents/endpoint-agent && go test ./...",
    "build:agent": "cd agents/endpoint-agent && go build -o bin/ ./cmd/endpoint-agent",
    "test:engine": "cd engine && go test ./...",
    "build:engine": "cd engine && go build -o bin/ ./cmd/nigafiy-engine"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8"
  }
}
