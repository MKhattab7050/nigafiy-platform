{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "db",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:db"
      ],
      "port": 5433
    },
    {
      "name": "api",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev:api"
      ],
      "port": 4100
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nigafiy/web",
        "dev"
      ],
      "port": 3100
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@nigafiy/site",
        "serve"
      ],
      "port": 3290
    }
  ]
}